{
  "name": "qr-pagamento-personalizado",
  "version": "1.0.0",
  "description": "Gestão de comissões com QR Code Pix: funcionários, lotes de pagamento, conciliação e painel.",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "knex": "3.1.0",
    "multer": "2.0.2",
    "mysql2": "3.12.0",
    "pg": "8.13.1",
    "qrcode": "1.5.4"
  }
}
