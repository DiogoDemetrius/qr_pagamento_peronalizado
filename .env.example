# Banco de dados principal (Postgres)
DATABASE_URL=postgres://pix:pix@localhost:5432/pix

# Servidor
PORT=3000

# Acesso ao painel (HTTP Basic). Obrigatório, a não ser que AUTH_DISABLED=true (só para desenvolvimento).
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# AUTH_DISABLED=true

# Dados que vão no QR quando o funcionário não tem cidade cadastrada
PIX_CIDADE_PADRAO=SAO PAULO
# Texto curto exibido no app de quem paga (opcional). {competencia} vira 2026-10, por exemplo.
PIX_DESCRICAO=Comissao {competencia}

# Pendências: pagamento pendente há mais de N dias aparece como atrasado no painel
DIAS_ALERTA_PENDENTE=3

# ---------------------------------------------------------------
# Fonte de comissão: webhook
# Outro sistema envia POST /api/webhooks/comissoes com o header X-Api-Key
# ---------------------------------------------------------------
WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# Fonte de comissão: outro banco de dados (somente leitura)
# A consulta recebe :competencia (AAAA-MM) e deve devolver a coluna "valor"
# e uma coluna que identifique o funcionário: funcionario_id, documento, ref_externa ou email.
# ---------------------------------------------------------------
EXTERNAL_DB_CLIENT=pg
EXTERNAL_DB_URL=
EXTERNAL_DB_QUERY=select vendedor_id as ref_externa, sum(comissao) as valor from vendas where to_char(data_venda, 'YYYY-MM') = :competencia group by vendedor_id

# ---------------------------------------------------------------
# Confirmação de pagamento pela API do banco pagador (Inter Empresas)
# Credenciais e certificado gerados no Internet Banking PJ (escopo extrato.read)
# ---------------------------------------------------------------
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter.crt
INTER_KEY_PATH=./certs/inter.key
# INTER_CONTA_CORRENTE=
# INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
